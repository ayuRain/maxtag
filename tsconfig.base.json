{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@opentag/core": ["packages/core/src/index.ts"],
      "@opentag/platform-lark": ["packages/platform-lark/src/index.ts"],
      "@opentag/platform-telegram": ["packages/platform-telegram/src/index.ts"],
      "@opentag/executor-codex": ["packages/executor-codex/src/index.ts"],
      "@opentag/executor-claude": ["packages/executor-claude/src/index.ts"],
      "@opentag/tools-github": ["packages/tools-github/src/index.ts"],
      "@opentag/memory": ["packages/memory/src/index.ts"],
      "@opentag/ui-cards": ["packages/ui-cards/src/index.ts"]
    }
  }
}


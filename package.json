{
  "name": "opentag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open agent mentions for work threads. Lark first, not Lark only.",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "node --watch apps/server/dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "worker": "node apps/worker/dist/index.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

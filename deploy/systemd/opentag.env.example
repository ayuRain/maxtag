# Shared by opentag-server, opentag-lark-bridge, opentag-worker, and opentag-scheduler.
OPENTAG_DATA_DIR=/var/lib/opentag
OPENTAG_STORAGE_DRIVER=sqlite
OPENTAG_SQLITE_PATH=/var/lib/opentag/opentag.sqlite
OPENTAG_SQLITE_BUSY_TIMEOUT_MS=5000

# Keep public traffic behind a TLS reverse proxy. Only the proxy should reach 3077.
OPENTAG_HOST=127.0.0.1
OPENTAG_PORT=3077
OPENTAG_ADMIN_COOKIE_SECURE=true
OPENTAG_ADMIN_TOKEN=replace-with-a-random-operator-token
OPENTAG_OPERATOR_SESSION_SECRET=replace-with-a-separate-random-session-secret
OPENTAG_CLIENT_INGRESS_TOKEN=replace-with-a-random-client-ingress-token
OPENTAG_WORKFLOW_INGRESS_TOKEN=replace-with-a-random-workflow-ingress-token
OPENTAG_ALERTMANAGER_INGRESS_TOKEN=replace-with-a-random-alertmanager-ingress-token
OPENTAG_ALERTMANAGER_INGRESS_MAX_BYTES=262144
OPENTAG_KNOWLEDGE_INGRESS_PRINCIPALS_JSON=

# Production process split.
OPENTAG_AGENT_WORKER=manual
OPENTAG_ROUTINE_SCHEDULER=external
OPENTAG_WORKFLOW_COORDINATOR=external
OPENTAG_WORKER_INTERVAL_MS=2000
OPENTAG_WORKER_BATCH=1
OPENTAG_AGENT_WORKER_STALE_MS=120000
OPENTAG_AGENT_RUN_HEARTBEAT_MS=15000
OPENTAG_RUN_CONTROL_POLL_MS=250
OPENTAG_SHUTDOWN_TIMEOUT_MS=25000

# Loopback observability. Mirror this token into the Prometheus credentials file.
OPENTAG_OBSERVABILITY_HOST=127.0.0.1
OPENTAG_WORKER_OBSERVABILITY_PORT=3078
OPENTAG_SCHEDULER_OBSERVABILITY_PORT=3079
OPENTAG_LARK_BRIDGE_OBSERVABILITY_PORT=3080
OPENTAG_METRICS_TOKEN=replace-with-a-random-metrics-token

OPENTAG_ROUTINES_ENABLED=true
OPENTAG_ROUTINE_TICK_INTERVAL_MS=30000
OPENTAG_ROUTINE_CLAIM_STALE_MS=120000
OPENTAG_ROUTINE_BATCH_SIZE=100
OPENTAG_WORKFLOWS_ENABLED=true
OPENTAG_WORKFLOW_TICK_INTERVAL_MS=2000
OPENTAG_WORKFLOW_CLAIM_STALE_MS=120000
OPENTAG_WORKFLOW_BATCH_SIZE=20
OPENTAG_LARK_DOCUMENT_WATCHER_ENABLED=true
OPENTAG_LARK_DOCUMENT_WATCHER_TICK_INTERVAL_MS=5000
OPENTAG_LARK_DOCUMENT_WATCHER_CLAIM_STALE_MS=120000
OPENTAG_LARK_DOCUMENT_WATCHER_BATCH_SIZE=5
OPENTAG_DEFAULT_TIME_ZONE=Asia/Shanghai

# Feishu/Lark app credentials and callback verification. OPENTAG_LARK_DOMAIN
# controls OpenAPI delivery only. The lark-cli profile below has its own
# feishu/lark brand for WebSocket ingress; verify it independently.
OPENTAG_LARK_TRANSPORT=http
OPENTAG_LARK_EVENT_MODE=long-connection
OPENTAG_LARK_DOMAIN=feishu
OPENTAG_LARK_APP_ID=replace-with-app-id
OPENTAG_LARK_APP_SECRET=replace-with-app-secret
OPENTAG_LARK_BOT_OPEN_ID=replace-with-bot-open-id
OPENTAG_LARK_CHAT_INFO_TIMEOUT_MS=10000
OPENTAG_LARK_VERIFICATION_TOKEN=replace-with-verification-token
OPENTAG_LARK_ENCRYPT_KEY=replace-with-encrypt-key
# false: members add the bot and mention it; true: require /pair for multi-project routing
OPENTAG_LARK_REQUIRE_BINDING=false
OPENTAG_SERVER_URL=http://127.0.0.1:3077
OPENTAG_LARK_WORKSPACE_ID=replace-with-workspace-id
OPENTAG_LARK_BRIDGE_EVENT_KEYS=im.message.receive_v1
OPENTAG_LARK_CLI_PROFILE=opentag-production
OPENTAG_LARK_BACKFILL_ENABLED=true
OPENTAG_LARK_BACKFILL_LOOKBACK_MS=600000
OPENTAG_LARK_BACKFILL_INTERVAL_MS=60000
OPENTAG_LARK_BACKFILL_MAX_WINDOW_MS=86400000
OPENTAG_LARK_BACKFILL_MAX_MESSAGES=1000
OPENTAG_LARK_BACKFILL_MAX_CHANNELS=500
OPENTAG_LARK_BACKFILL_STATE_FILE=/var/lib/opentag/lark-bridge-checkpoint.json

# Optional Slack Events API client. Keep memory mode until the app has been
# installed with app_mentions:read, im:history, chat:write, and files:write.
OPENTAG_SLACK_TRANSPORT=memory
OPENTAG_SLACK_BOT_TOKEN=replace-with-bot-token
OPENTAG_SLACK_BOT_USER_ID=replace-with-bot-user-id
OPENTAG_SLACK_SIGNING_SECRET=replace-with-signing-secret
OPENTAG_SLACK_WORKSPACE_ID=replace-with-workspace-id
OPENTAG_SLACK_CALLBACK_MAX_SKEW_SECONDS=300
OPENTAG_SLACK_CALLBACK_MAX_BYTES=1048576
OPENTAG_SLACK_REQUIRE_BINDING=true

# Optional GitHub issue/PR comments and brokered GitHub tools. Prefer a GitHub
# App installation in production. Configure all three App fields, or set only
# OPENTAG_GITHUB_TOKEN for a legacy deployment token; never configure both.
OPENTAG_GITHUB_TRANSPORT=memory
OPENTAG_GITHUB_TOKEN=
OPENTAG_GITHUB_APP_ID=
OPENTAG_GITHUB_APP_INSTALLATION_ID=
OPENTAG_GITHUB_APP_PRIVATE_KEY_FILE=
OPENTAG_GITHUB_BOT_LOGIN=
OPENTAG_GITHUB_WEBHOOK_SECRET=
OPENTAG_GITHUB_BASE_URL=
OPENTAG_GITHUB_WORKSPACE_ID=replace-with-workspace-id
OPENTAG_GITHUB_REQUIRE_BINDING=true

# The service account must authenticate both CLIs under /var/lib/opentag.
OPENTAG_EXECUTOR_MODE=local-cli
OPENTAG_EXECUTOR_WORKSPACE_ROOT=/srv/opentag/workspaces
OPENTAG_ARTIFACT_ROOT=/var/lib/opentag/artifacts
OPENTAG_EXECUTOR_TIMEOUT_MS=1200000
OPENTAG_EXECUTOR_SESSION_MODE=provider
OPENTAG_CODEX_COMMAND=codex
OPENTAG_CODEX_APP_SERVER=true
OPENTAG_CODEX_CONTEXT_COMPACTION_THRESHOLD=0.85
OPENTAG_CODEX_HOME=/var/lib/opentag/providers/codex
OPENTAG_CODEX_AUTH_SOURCE_HOME=
OPENTAG_CLAUDE_COMMAND=claude
OPENTAG_MEMORY_EXECUTOR=codex
OPENTAG_MEMORY_MODEL=gpt-5.6-luna
# Optional per-purpose overrides; unset values inherit OPENTAG_MEMORY_MODEL.
OPENTAG_MEMORY_RETRIEVAL_MODEL=
OPENTAG_MEMORY_QUERY_MODEL=
OPENTAG_MEMORY_ANALYSIS_MODEL=
OPENTAG_MEMORY_WRAPUP_MODEL=
OPENTAG_MEMORY_ANALYSIS_TIMEOUT_MS=300000
OPENTAG_MEMORY_ANALYSIS_MAX_ENTRIES=200
OPENTAG_MEMORY_ANALYSIS_MAX_CHARS=200000
OPENTAG_MEMORY_ANALYSIS_MIN_CONFIDENCE=0.65
OPENTAG_MEMORY_RETRIEVAL_ENABLED=true
OPENTAG_MEMORY_RETRIEVAL_TIMEOUT_MS=15000
OPENTAG_MEMORY_RETRIEVAL_MAX_CANDIDATE_LINES=120
OPENTAG_MEMORY_RETRIEVAL_MAX_CANDIDATE_CHARS=48000
OPENTAG_MEMORY_RETRIEVAL_MAX_SELECTED_LINES=16
OPENTAG_MEMORY_RETRIEVAL_MIN_CONFIDENCE=0.5
OPENTAG_MEMORY_WRAPUP_ENABLED=true
OPENTAG_MEMORY_WRAPUP_INTERVAL_MS=2000
OPENTAG_MEMORY_WRAPUP_DEBOUNCE_MS=15000
OPENTAG_MEMORY_WRAPUP_BATCH_SIZE=1
OPENTAG_MEMORY_WRAPUP_STALE_MS=600000
OPENTAG_MEMORY_WRAPUP_RETRY_BASE_MS=30000
OPENTAG_MEMORY_WRAPUP_MAX_ATTEMPTS=5
OPENTAG_MEMORY_WRAPUP_RETENTION_MS=604800000
OPENTAG_KNOWLEDGE_ENRICHMENT_ENABLED=true
OPENTAG_KNOWLEDGE_EXECUTOR=codex
OPENTAG_KNOWLEDGE_MODEL=gpt-5.6-luna
OPENTAG_KNOWLEDGE_ENRICHMENT_INTERVAL_MS=2000
OPENTAG_KNOWLEDGE_ENRICHMENT_BATCH_SIZE=2
OPENTAG_KNOWLEDGE_ENRICHMENT_TIMEOUT_MS=120000
OPENTAG_KNOWLEDGE_ENRICHMENT_LEASE_MS=120000
OPENTAG_KNOWLEDGE_ENRICHMENT_RETRY_BASE_MS=5000
OPENTAG_KNOWLEDGE_REFRESH_ENABLED=true
OPENTAG_KNOWLEDGE_REFRESH_INTERVAL_MS=2000
OPENTAG_KNOWLEDGE_REFRESH_BATCH_SIZE=2
OPENTAG_KNOWLEDGE_REFRESH_TIMEOUT_MS=30000
OPENTAG_KNOWLEDGE_REFRESH_LEASE_MS=120000
OPENTAG_KNOWLEDGE_REFRESH_RETRY_BASE_MS=5000
OPENTAG_DELEGATED_AGENT_TASKS_ENABLED=true
OPENTAG_DELEGATED_AGENT_TASKS_INTERVAL_MS=1000
OPENTAG_DELEGATED_AGENT_TASKS_BATCH_SIZE=2
OPENTAG_DELEGATED_AGENT_TASKS_LEASE_MS=120000
OPENTAG_DELEGATED_AGENT_TASKS_RETRY_BASE_MS=5000
OPENTAG_TOOL_MAX_CALLS_PER_RUN=100
OPENTAG_TOOL_CALL_TIMEOUT_MS=30000
OPENTAG_TOOL_APPROVAL_TTL_MS=900000

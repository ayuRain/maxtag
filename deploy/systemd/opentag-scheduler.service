[Unit]
Description=OpenTag routine and workflow scheduler
Documentation=file:/opt/opentag/deploy/README.md
Wants=network-online.target opentag-server.service
After=network-online.target opentag-server.service
PartOf=opentag.target

[Service]
Type=simple
User=opentag
Group=opentag
WorkingDirectory=/opt/opentag
Environment=NODE_ENV=production
Environment=HOME=/var/lib/opentag
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/opentag/opentag.env
ExecStart=/usr/bin/env node /opt/opentag/apps/scheduler/dist/index.js
Restart=always
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=yes
UMask=0077
StateDirectory=opentag
StateDirectoryMode=0750
ReadWritePaths=-/srv/opentag/workspaces
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
TasksMax=1024

[Install]
WantedBy=opentag.target
